# Postgres connection string (Neon / Vercel Postgres). Leave unset locally to use SQLite in ./data/dev.db
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Long random string used to sign login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me"

# Public base URL of the site (used in invite links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
